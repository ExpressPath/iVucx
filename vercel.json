{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "outputDirectory": ".",
  "functions": {
    "api/*.js": {
      "excludeFiles": "jscoq/**"
    }
  },
  "routes": [
    {
      "src": "/api/jscoq/(.*)",
      "dest": "/api/jscoq-proxy.js?path=$1"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
