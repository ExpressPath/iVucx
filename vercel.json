{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "outputDirectory": ".",
  "functions": {
    "api/*.js": {
      "excludeFiles": "jscoq/**"
    }
  },
  "headers": [
    {
      "source": "/post-preview.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/post-runner.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/editor.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    }
  ],
  "routes": [
    {
      "src": "/api/jscoq/(.*)",
      "dest": "/api/jscoq-proxy?path=$1"
    },
    {
      "src": "/api/helper",
      "dest": "/api/helper"
    },
    {
      "src": "/api/helper/(.*)",
      "dest": "/api/helper?route=$1"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
