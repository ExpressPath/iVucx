{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "outputDirectory": ".vercel-static",
  "functions": {
    "api/*.js": {
      "excludeFiles": "jscoq/**"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; frame-ancestors 'none'; object-src 'self' blob: data:; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.jsdelivr.net https://accounts.google.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' data: blob: https:; connect-src 'self' https: wss:; frame-src 'self' blob: data: https://accounts.google.com https://checkout.stripe.com https://billing.stripe.com https://link.com; worker-src 'self' blob:; form-action 'self'; upgrade-insecure-requests"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), usb=(), serial=(), payment=(self)"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "Origin-Agent-Cluster",
          "value": "?1"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/post-preview.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/post-runner.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/editor.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    }
  ],
  "routes": [
    {
      "src": "/(?:\\.env(?:\\..*)?|\\.(?:git|vercel|vscode)(?:/.*)?|(?:lib|supabase|docs|desktop|server-tools|services|scripts|tests|lean|jscoq)(?:/.*)?|(?:\\.dockerignore|\\.gitignore|\\.npmrc|\\.vercelignore|Dockerfile|build-vercel-static\\.mjs|index\\.js|render\\.yaml|README\\.md|package(?:-lock)?\\.json|vercel\\.json))",
      "status": 404
    },
    {
      "src": "/api/.*\\.(?:js|cjs|mjs|map)$",
      "status": 404
    },
    {
      "src": "/api/jscoq/(.*)",
      "dest": "/api/jscoq-proxy?path=$1"
    },
    {
      "src": "/api/helper",
      "dest": "/api/helper"
    },
    {
      "src": "/api/helper/(.*)",
      "dest": "/api/helper?route=$1"
    },
    {
      "src": "/api/bounty-checkout",
      "dest": "/api/helper?route=bounty-checkout"
    },
    {
      "src": "/api/conditional-checkout",
      "dest": "/api/helper?route=conditional-checkout"
    },
    {
      "src": "/api/stripe-setup",
      "dest": "/api/helper?route=stripe-setup"
    },
    {
      "src": "/api/proof-ai",
      "dest": "/api/helper?route=proof-ai"
    },
    {
      "src": "/api/google-auth-start",
      "dest": "/api/google?route=auth-start"
    },
    {
      "src": "/api/google-auth-callback",
      "dest": "/api/google?route=auth-callback"
    },
    {
      "src": "/api/google-files",
      "dest": "/api/google?route=files"
    },
    {
      "src": "/api/google-import",
      "dest": "/api/google?route=import"
    },
    {
      "src": "/api/google-one-tap",
      "dest": "/api/google?route=one-tap"
    },
    {
      "src": "/api/google-status",
      "dest": "/api/google?route=status"
    },
    {
      "src": "/api/email-verification",
      "dest": "/api/google?route=email-verification"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
