NODE_ENV=development
PORT=3000

# Supabase server-side APIs: BlueMode auth, cookie consent, and helper persistence.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional fallback when URL is not available but the project ref is known.
SUPABASE_PROJECT_REF=
# Production Postgres connection string for admin SQL operations only.
# Do not expose this to browser code. Used by scripts/supabase-remote-access.ps1.
SUPABASE_DB_URL=

# Gemini-backed saved problem/theorem search. Server-side only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Google upload import.
# Local development can use the Desktop client JSON that was provided.
GOOGLE_CLIENT_SECRET_PATH=C:\Users\funct\Downloads\client_secret_60857015250-93sdebpl1pmc120sg29ichtd5q3h98o3.apps.googleusercontent.com.json

# For Vercel or Google Compute Engine, prefer a Web application OAuth client.
# Put the full JSON in one of these variables, or point GOOGLE_CLIENT_SECRET_PATH
# at a secret file on the server.
GOOGLE_CLIENT_SECRET_JSON=
GOOGLE_CLIENT_SECRET_BASE64=

# Public URL for this iVucx app. The effective callback becomes:
#   <GOOGLE_PUBLIC_BASE_URL>/api/google-auth-callback
# Register that exact URL in Google Cloud OAuth client settings.
GOOGLE_PUBLIC_BASE_URL=
GOOGLE_REDIRECT_URI=

GOOGLE_IMPORT_MAX_BYTES=26214400
GOOGLE_TEXT_PREVIEW_BYTES=1048576

# Existing proof/helper deployment.
HELPER_API_BASE_URL=
HELPER_API_KEY=
EXECUTION_API_BASE_URL=
EXECUTION_API_KEY=
ALLOW_LOCAL_EXECUTION_FALLBACK=false
ALLOW_LOCAL_HELPER_FALLBACK=false
