# Copy this file to promotion/.env. Never commit the real file.
#
# Shared
PROMOTION_PUBLIC_URL=
# Publishing is blocked unless this exact value is set and the CLI is invoked
# with the "publish" command.
PROMOTION_CONFIRM_PUBLISH=NO

# X API v2
# Required user scopes: tweet.read tweet.write users.read offline.access
X_USER_ACCESS_TOKEN=
X_CLIENT_ID=
X_CLIENT_SECRET=

# TikTok Content Posting API
# Use video.upload for drafts or video.publish for Direct Post.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=
TIKTOK_OPEN_ID=
TIKTOK_POST_MODE=MEDIA_UPLOAD

# Instagram API with Instagram Login (Professional account)
# Required permissions: instagram_business_basic,
# instagram_business_content_publish
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
# Keep the API version explicit so an upgrade is intentional.
INSTAGRAM_API_VERSION=
INSTAGRAM_GRAPH_BASE_URL=https://graph.instagram.com
